{
  "name": "adinn-bengaluru-activation-manager-gps-backend",
  "version": "5.2.0",
  "type": "module",
  "description": "Backend API for ADINN Bengaluru Activation Manager",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seedFromExcel.js",
    "seed:keep": "node src/seedFromExcel.js --keep-existing",
    "health": "node -e \"fetch('http://localhost:5001/health').then(r=>r.json()).then(console.log)\""
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "multer": "2.0.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "nodemon": "3.1.7"
  },
  "engines": {
    "node": ">=20 <23"
  }
}
